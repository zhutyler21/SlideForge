# ===== API 连接配置 =====
# 默认使用 OpenAI 官方地址，如需使用第三方代理请自行修改
BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-xxx

# ===== 模型配置 =====
# 各步骤使用不同模型，按 pipeline 顺序排列：
#
#   Step 1 大纲生成  → OUTLINE_GEN_MODEL   (需要强推理能力，推荐 claude-opus)
#   Step 2 内容展开  → (复用 OUTLINE_GEN_MODEL)
#   Step 3 提示词生成 → PROMPT_GEN_MODEL    (文本生成，轻量模型即可)
#   Step 4 图片生成  → IMAGE_GEN_MODEL      (需要图片生成能力的模型)
#   参考图分析       → VISION_MODEL          (需要视觉理解能力)
#
# 用法示例：
#   OUTLINE_GEN_MODEL=claude-opus-4-6                  # 大纲 & 内容（强推理）
#   PROMPT_GEN_MODEL=gemini-3.1-flash-lite-preview     # 提示词（轻量快速）
#   IMAGE_GEN_MODEL=gemini-3.1-flash-image-preview     # 画图（图片生成）
#   VISION_MODEL=gemini-3.1-flash-lite-preview         # 参考图分析（视觉理解）

OUTLINE_GEN_MODEL=claude-opus-4-6
PROMPT_GEN_MODEL=gemini-3.1-flash-lite-preview
IMAGE_GEN_MODEL=gemini-3.1-flash-image-preview
VISION_MODEL=gemini-3.1-flash-lite-preview
